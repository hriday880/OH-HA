# ==============================================================================
# OpenHuman & Hermes Telegram Companion Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot Credentials & Security
# ------------------------------------------------------------------------------
# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Comma-separated list or JSON array of authorized Telegram numeric user IDs.
# Run `/status` or check with @userinfobot to find your Telegram User ID.
# In production mode, any request from an unlisted user will be blocked.
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# ------------------------------------------------------------------------------
# 2. Primary LLM Provider Settings (Hermes / OpenHuman)
# ------------------------------------------------------------------------------
# Provider choice: 'openrouter', 'groq', 'together', 'ollama', 'openai', or 'mock'
LLM_PROVIDER=openrouter

# Model identifier (e.g. NousResearch Hermes 3 Llama 3.1)
LLM_MODEL=nousresearch/hermes-3-llama-3.1-8b

# API Key for the primary provider (OpenRouter / Groq / OpenAI / etc.)
LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Custom API Base URL (optional, useful for Ollama, vLLM, or OpenAI-compatible gateways)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Sampling temperature (0.0 = deterministic, 2.0 = creative, default = 0.7)
LLM_TEMPERATURE=0.7

# Maximum tokens for LLM generation
LLM_MAX_TOKENS=1024

# Maximum retry attempts on transient rate-limits / timeouts
LLM_MAX_RETRIES=3

# Multi-step reasoning loop iteration limit (1 - 20)
MAX_REASONING_STEPS=5

# ------------------------------------------------------------------------------
# 3. Fallback LLM Provider Settings (Optional)
# ------------------------------------------------------------------------------
# Secondary fallback provider if the primary provider experiences downtime / 429
# FALLBACK_LLM_PROVIDER=groq
# FALLBACK_LLM_MODEL=llama-3.1-8b-instant
# FALLBACK_LLM_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 4. Obsidian Vault & Remote Git Synchronization
# ------------------------------------------------------------------------------
# Local path inside the container / system where the Obsidian vault is stored
VAULT_PATH=/app/vault

# Remote Git Repository URL (HTTPS or SSH) for the user's Obsidian Vault
# Compatible with GitHub, GitLab, Gitea, or any self-hosted Git server
GIT_REMOTE_URL=https://github.com/username/my-obsidian-vault.git
# OBSIDIAN_GIT_REPO_URL=https://github.com/username/my-obsidian-vault.git

# Target Git branch to synchronize
GIT_BRANCH=main

# HTTPS Personal Access Token (PAT) with repo read/write scopes
GIT_AUTH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Raw SSH private key or path to SSH key for SSH Git auth (alternative to PAT)
# GIT_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n...\n-----END OPENSSH PRIVATE KEY-----"

# Author identity for automated commits created by the agent
GIT_AUTHOR_NAME=OpenHuman Hermes Bot
GIT_AUTHOR_EMAIL=bot@openhuman.local

# Background periodic synchronization interval in seconds (default: 1800s / 30 mins, 0 to disable)
AUTO_SYNC_INTERVAL_SECONDS=1800

# ------------------------------------------------------------------------------
# 5. Cloud Container Runtime & Keepalive Health Server
# ------------------------------------------------------------------------------
# Port for the keepalive HTTP health server (GET /health, GET /metrics)
PORT=8080

# Host address to bind the HTTP server to (0.0.0.0 for containers)
HOST=0.0.0.0

# Execution environment ('production', 'development', or 'test')
ENVIRONMENT=production

# Logging verbosity ('DEBUG', 'INFO', 'WARNING', 'ERROR')
LOG_LEVEL=INFO
